{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "node",
    "jest"
  ],
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "app",
    "dist",
    "coverage",
    "node_modules"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "none",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    "jest/require-to-throw-message": "off"
  }
}
